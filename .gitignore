# --- Secrets: never commit these ---
.env
.streamlit/secrets.toml

# --- Python environment ---
.venv/
__pycache__/
*.pyc

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data from the YouTube API ---
# YouTube API terms do not allow sharing or keeping API data for long,
# so raw responses and the database stay on your PC only.
data/raw/*
data/processed/*
db/*.db
!**/.gitkeep
!data/raw/README.md
!data/processed/README.md

# --- Logs and OS junk ---
*.log
.DS_Store
Thumbs.db
